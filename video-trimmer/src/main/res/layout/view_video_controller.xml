<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_filmstrip_container"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginStart="14dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Rounded Thumbnail Filmstrip (inset by 16dp horizontally so Left/Right handles frame it cleanly) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_filmstrip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="3dp"
        app:cardBackgroundColor="#0D0D0D"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#26FFFFFF"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_filmstrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Material 3 Range Overlay (Handles + Dimmed Scrims + Playhead) -->
    <com.gowtham.library.ui.TrimmerRangeOverlayView
        android:id="@+id/range_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
