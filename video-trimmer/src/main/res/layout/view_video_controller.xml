<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_filmstrip_container"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <!-- Rounded Thumbnail Filmstrip -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_filmstrip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_filmstrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Material 3 Range Overlay (Handles + Scrims + Playhead) -->
    <com.gowtham.library.ui.TrimmerRangeOverlayView
        android:id="@+id/range_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
