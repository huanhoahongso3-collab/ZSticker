<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 Light Theme matching ZSticker -->
    <style name="VideoTrimmerTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/trimmer_orange_primary</item>
        <item name="colorPrimaryContainer">@color/trimmer_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/trimmer_on_orange_container</item>
        <item name="colorSecondary">@color/trimmer_orange_primary</item>
        <item name="colorSecondaryContainer">@color/trimmer_orange_container</item>
        <item name="colorOnSecondaryContainer">@color/trimmer_on_orange_container</item>

        <item name="colorSurface">@color/trimmer_light_surface</item>
        <item name="colorSurfaceContainer">@color/trimmer_light_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/trimmer_light_surface_container_high</item>
        <item name="colorOnSurface">@color/trimmer_light_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/trimmer_light_on_surface_variant</item>
        <item name="android:colorBackground">@color/trimmer_light_surface</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
    </style>

    <style name="TrimmerToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StyleRoot" parent="Widget.Support.CoordinatorLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="AppTheme.PopupMenu" parent="Widget.Material3.PopupMenu" />

    <style name="AppTheme.PopupMenu.Old" parent="Widget.Material3.PopupMenu" />

    <style name="FView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="VWView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="WView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="VView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="LView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="TxtRgStyle22" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="TxtSemiSmallStyle22" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="ImageTrim">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
</resources>
