<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        style="@style/Widget.Material3Expressive.AppBarLayout"
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="9dp"
                    android:src="@drawable/ic_back_bold"
                    app:tint="?attr/colorOnSecondaryContainer"
                    android:contentDescription="@null" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                        android:includeFontPadding="false"
                android:id="@+id/txtHeaderTitle"
                style="@style/TextAppearance.Material3.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_files_title"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- 1. Import Card (Segmented TOP) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/itemImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                    android:layout_gravity="center_vertical"
                        android:id="@+id/imgImport"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="16dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_import"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                        android:includeFontPadding="false"
                            android:id="@+id/titleImport"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_import_title"
                            android:textStyle="bold" />

                        <TextView
                        android:includeFontPadding="false"
                            android:id="@+id/noteImport"
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/import_auto_note" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1b. Import legacy backup (Segmented MIDDLE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImportLegacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgImportLegacy"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_import_history" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/titleImportLegacy"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/import_legacy_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/noteImportLegacy"
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:text="@string/import_legacy_note" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Export Backup Card (Segmented MIDDLE with Expandable Options) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/itemExportHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:minHeight="76dp"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                    android:layout_gravity="center_vertical"
                            android:id="@+id/imgExportHeader"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="16dp"
                            android:padding="9dp"
                            android:src="@drawable/ic_export"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                        android:includeFontPadding="false"
                                android:id="@+id/titleExport"
                                style="@style/TextAppearance.Material3.TitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/info_export_title"
                                android:textStyle="bold" />

                            <TextView
                        android:includeFontPadding="false"
                                android:id="@+id/noteExport"
                                style="@style/TextAppearance.Material3.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/export_choose_note" />
                        </LinearLayout>

                        <ImageView
                    android:layout_gravity="center_vertical"
                            android:id="@+id/imgExpand"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_circle_icon"
                            android:padding="7dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/expandableExport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/exportImage"
                            style="@style/InfoItemStyle"
                            android:paddingVertical="12dp">
                            <ImageView
                    android:layout_gravity="center_vertical"
                                android:id="@+id/imgExportImage"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:padding="7dp"
                                android:src="@drawable/ic_export_image"
                                android:contentDescription="@null" />
                            <TextView
                        android:includeFontPadding="false"
                                android:id="@+id/txtExportImage"
                                style="@style/TextAppearance.Material3.BodyLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/export_image" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/exportHistory"
                            style="@style/InfoItemStyle"
                            android:paddingVertical="12dp">
                            <ImageView
                    android:layout_gravity="center_vertical"
                                android:id="@+id/imgExportHistory"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:padding="7dp"
                                android:src="@drawable/ic_export_history"
                                android:contentDescription="@null" />
                            <TextView
                        android:includeFontPadding="false"
                                android:id="@+id/txtExportHistory"
                                style="@style/TextAppearance.Material3.BodyLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/export_history" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/exportSettings"
                            style="@style/InfoItemStyle"
                            android:paddingVertical="12dp">
                            <ImageView
                    android:layout_gravity="center_vertical"
                                android:id="@+id/imgExportSettings"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:padding="7dp"
                                android:src="@drawable/ic_export_settings"
                                android:contentDescription="@null" />
                            <TextView
                        android:includeFontPadding="false"
                                android:id="@+id/txtExportSettings"
                                style="@style/TextAppearance.Material3.BodyLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/export_settings" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/exportAll"
                            style="@style/InfoItemStyle"
                            android:paddingVertical="12dp">
                            <ImageView
                    android:layout_gravity="center_vertical"
                                android:id="@+id/imgExportAll"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:padding="7dp"
                                android:src="@drawable/ic_export_all"
                                android:contentDescription="@null" />
                            <TextView
                        android:includeFontPadding="false"
                                android:id="@+id/txtExportAll"
                                style="@style/TextAppearance.Material3.BodyLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/export_all" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Save All Stickers to Gallery Card (Segmented BOTTOM) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExportGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/itemExportGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                    android:layout_gravity="center_vertical"
                        android:id="@+id/imgExportGallery"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="16dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_export_gallery"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                        android:includeFontPadding="false"
                            android:id="@+id/titleExportGallery"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/export_to_gallery_title"
                            android:textStyle="bold" />

                        <TextView
                        android:includeFontPadding="false"
                            android:id="@+id/noteExportGallery"
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/export_to_gallery_note" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
