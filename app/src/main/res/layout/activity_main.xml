<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Material 3 Expressive Editorial Header -->
    <com.google.android.material.appbar.AppBarLayout
        style="@style/Widget.Material3Expressive.AppBarLayout"
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:id="@+id/expressiveHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/txtToolbarTitle"
                style="@style/TextAppearance.Material3.HeadlineMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.015"
                android:singleLine="true"
                android:text="@string/nav_home"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtToolbarBadge"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingHorizontal="11dp"
                android:paddingVertical="3dp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Multi-Screen Host Container (HomeFragment, RecentsFragment, OptionsFragment) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Material 3 Expressive Borderless Floating Bottom Navigation Bar (74% Alpha) + Circular FAB -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/floatingBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/floatingBottomRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/floatingNavCard"
                style="@style/FloatingNavCardStyle"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/floatingNavTabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Tab 1: Home -->
                    <LinearLayout
                        android:id="@+id/navTabHome"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/iconNavHome"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_home"
                            android:contentDescription="@string/nav_home" />

                        <TextView
                            android:id="@+id/txtNavHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="none"
                            android:singleLine="true"
                            android:text="@string/nav_home"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tab 2: Recents -->
                    <LinearLayout
                        android:id="@+id/navTabRecents"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/iconNavRecents"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_history"
                            android:contentDescription="@string/nav_recents" />

                        <TextView
                            android:id="@+id/txtNavRecents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="none"
                            android:singleLine="true"
                            android:text="@string/nav_recents"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Tab 3: Options -->
                    <LinearLayout
                        android:id="@+id/navTabOptions"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/iconNavOptions"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_more_horiz"
                            android:contentDescription="@string/nav_options" />

                        <TextView
                            android:id="@+id/txtNavOptions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="none"
                            android:singleLine="true"
                            android:text="@string/nav_options"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/addButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="22dp"
                app:backgroundTint="?attr/colorPrimary"
                app:elevation="0dp"
                app:fabCustomSize="60dp"
                app:hoveredFocusedTranslationZ="0dp"
                app:maxImageSize="26dp"
                app:pressedTranslationZ="0dp"
                app:shapeAppearance="@style/ShapeAppearance.ZSticker.FullCircle"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ZSticker.FullCircle"
                app:srcCompat="@drawable/ic_add"
                app:tint="?attr/colorOnPrimary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Full-Screen Expressive Loading Indicator Overlay -->
    <FrameLayout
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:translationZ="10dp"
        android:visibility="gone">

        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/loadingIndicator"
            android:layout_width="480dp"
            android:layout_height="480dp"
            android:layout_gravity="center"
            app:indicatorColor="?attr/colorPrimary" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
