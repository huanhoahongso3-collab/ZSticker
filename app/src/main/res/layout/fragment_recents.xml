<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="116dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

    <LinearLayout
        android:id="@+id/emptyRecentsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="108dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgEmptyRecents"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:padding="30dp"
            android:src="@drawable/ic_empty_history"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtEmptyRecentsTitle"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/no_history_found"
            android:textAlignment="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEmptyRecentsSubtitle"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="280dp"
            android:text="@string/empty_history_subtitle"
            android:textAlignment="center" />
    </LinearLayout>
</FrameLayout>
