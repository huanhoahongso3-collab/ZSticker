<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optionsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="116dp"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- GROUP 1: APPEARANCE & SETTINGS -->
        <TextView
                        android:includeFontPadding="false"
            android:id="@+id/headerSettings"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/section_settings"
            android:textStyle="bold" />

        <!-- 1.1 Theme (TOP) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgTheme"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_palette"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleTheme"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_theme_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/txtCurrentTheme"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/theme_system" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1.2 Material Color (MIDDLE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMaterialColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgMaterialColor"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_water_drop"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleMaterialColor"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_material_color_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/subtitleMaterialColor"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/info_material_color_subtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMaterialColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:thumbIcon="@drawable/ic_switch_thumb" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1.3 Online Remove BG (MIDDLE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOnlineRemoveBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgOnlineRemoveBg"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_remove_bg"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleOnlineRemoveBg"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_online_removebg_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/subtitleOnlineRemoveBg"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/info_online_removebg_subtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchOnlineRemoveBg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:thumbIcon="@drawable/ic_switch_thumb" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- new AutoCrop (MIDDLE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAutoCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgAutoCrop"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_crop"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleAutoCrop"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_auto_crop_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/subtitleAutoCrop"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/info_auto_crop_subtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoCrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:thumbIcon="@drawable/ic_switch_thumb" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- new AutoResize (MIDDLE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAutoResize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgAutoResize"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_view_full"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleAutoResize"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_auto_resize_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/subtitleAutoResize"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/info_auto_resize_subtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoResize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:thumbIcon="@drawable/ic_switch_thumb" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1.4 Language (BOTTOM) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgLanguage"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_language"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleLanguage"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_language_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/txtCurrentLanguage"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/lang_system" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- GROUP 2: DATA & STORAGE -->
        <TextView
                        android:includeFontPadding="false"
            android:id="@+id/headerStorage"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:paddingStart="8dp"
            android:paddingTop="22dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/section_storage"
            android:textStyle="bold" />

        <!-- 2.1 Import/Export (TOP) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgFiles"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_import_export"
                    android:contentDescription="@null" />

                <TextView
                        android:includeFontPadding="false"
                    android:id="@+id/titleFiles"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/info_files_title"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2.2 Remove All Recent (MIDDLE - Destructive) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRemoveRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgRemoveRecent"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_delete_history"
                    android:contentDescription="@null" />

                <TextView
                        android:includeFontPadding="false"
                    android:id="@+id/txtRemoveRecent"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/info_remove_recent_title"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2.3 Remove All Stickers (BOTTOM - Destructive) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRemoveAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgRemoveAll"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_delete_all"
                    android:contentDescription="@null" />

                <TextView
                        android:includeFontPadding="false"
                    android:id="@+id/txtRemoveAll"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/info_remove_all_title"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- GROUP 3: ABOUT -->
        <TextView
                        android:includeFontPadding="false"
            android:id="@+id/headerGeneral"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:paddingStart="8dp"
            android:paddingTop="22dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/section_general"
            android:textStyle="bold" />

        <!-- 3.1 Version (TOP) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgVersion"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleVersion"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_version_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/txtVersion"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="1.0.0" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3.2 Source Code (MIDDLE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgRepo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_code"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleRepo"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_repo_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/subtitleRepo"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/info_repo_note" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3.3 License (MIDDLE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgLicense"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_description"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleLicense"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_license_title"
                        android:textStyle="bold" />

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/subtitleLicense"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/info_license_note" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3.4 Open Source Licenses (BOTTOM) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOpenSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imgOpenSource"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="16dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_opensource"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:id="@+id/titleOpenSource"
